# Copiar este archivo a ".env" y completar con las credenciales reales.
# El archivo ".env" NUNCA debe subirse a Git.

APP_NAME="VIVÍ SMA API"
ENVIRONMENT=development

# Opción A: definir la URL completa de conexión (tiene prioridad si se define).
# Debe usar el driver psycopg (psycopg 3):
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/vivi_sma

# Opción B: definir las variables individuales y dejar que la app arme la URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vivi_sma
